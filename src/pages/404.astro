---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page not found" noIndex>
  <div class="container error-page">
    <p class="error-page__code" aria-hidden="true">
      404
    </p>
    <h1>Page not found</h1>
    <p class="text-lead" style="margin-top:1rem;">
      The page you're looking for doesn't exist, or may have moved.
    </p>
    <div class="hero__cta" style="justify-content:center;margin-top:2rem;">
      <a class="btn btn-primary" href={base}>
        <Icon name="arrow-right" style="width:1em;height:1em;transform:rotate(180deg);" /> Back home
      </a>
    </div>
  </div>
</BaseLayout>
