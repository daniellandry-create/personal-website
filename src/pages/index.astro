---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Icon from "../components/Icon.astro";
import { siteConfig } from "../site.config";

const allProjects = await getCollection("projects");
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const base = import.meta.env.BASE_URL;
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <section class="section hero container">
    <div>
      <p class="eyebrow">Hi, I'm Daniel 👋</p>
      <h1>{siteConfig.tagline}</h1>
      <p class="text-lead" style="margin-top:1.25rem;">
        I'm an Electrical Engineering & Computer Science student at Yale University. I like building
        things that cross the line between hardware and software -- CAD, embedded electronics, and
        code -- whether that's a machine that renders images in dice or a vending machine for
        student art. [ADD A PHOTO OF YOURSELF where the avatar placeholder is.]
      </p>
      <div class="hero__cta">
        <a class="btn btn-primary" href={`${base}resume/`}>
          Resume <Icon name="arrow-right" style="width:1em;height:1em;" />
        </a>
        <a class="btn btn-secondary" href={`${base}projects/`}>
          View projects
        </a>
        <a class="btn btn-secondary" href={`${base}contact/`}>
          Get in touch
        </a>
      </div>
    </div>
    <div class="avatar" role="img" aria-label={`${siteConfig.name} avatar placeholder`}>
      <span aria-hidden="true">{siteConfig.initials}</span>
    </div>
  </section>

  <section class="section--tight container">
    <div class="page-header" style="padding-block:0 1.5rem;max-width:none;">
      <div style="display:flex;align-items:baseline;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
        <h2>Selected projects</h2>
        <a class="link-inline" href={`${base}projects/`}>
          View all projects →
        </a>
      </div>
    </div>
    <div class="grid grid--projects">
      {featured.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
</BaseLayout>
