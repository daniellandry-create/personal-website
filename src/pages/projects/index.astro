---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { siteConfig } from "../../site.config";

const projects = (await getCollection("projects")).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.order - b.data.order;
});
---

<BaseLayout title="Projects" description={`A selection of projects by ${siteConfig.name}.`}>
  <div class="container">
    <header class="page-header">
      <p class="eyebrow">Projects</p>
      <h1>Selected work</h1>
      <p>
        A few things I'm building, mostly at the intersection of hardware and software. More photos
        and video are on the way as each project develops.
      </p>
    </header>

    <section class="section--tight">
      {projects.length > 0 ? (
        <div class="grid grid--projects">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      ) : (
        <p class="empty-state">No projects yet — check back soon.</p>
      )}
    </section>
  </div>
</BaseLayout>
