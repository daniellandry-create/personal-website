---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import MediaGallery from "../../components/MediaGallery.astro";
import Icon from "../../components/Icon.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, role, dateRange, tags, liveUrl, repoUrl, gallery, video } =
  project.data;
---

<BaseLayout title={title} description={description}>
  <article class="container section--tight">
    <header class="page-header">
      <p class="eyebrow">Project</p>
      <h1>{title}</h1>
      {(role || dateRange) && (
        <p class="text-muted">
          {role}
          {role && dateRange && " · "}
          {dateRange}
        </p>
      )}
      {tags.length > 0 && (
        <ul class="tag-list" style="margin-top:1rem;">
          {tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )}
      {(liveUrl || repoUrl) && (
        <div class="hero__cta" style="margin-top:1.5rem;">
          {liveUrl && (
            <a class="btn btn-primary" href={liveUrl} target="_blank" rel="noopener noreferrer">
              Live demo <Icon name="external" style="width:1em;height:1em;" />
            </a>
          )}
          {repoUrl && (
            <a class="btn btn-secondary" href={repoUrl} target="_blank" rel="noopener noreferrer">
              Source <Icon name="external" style="width:1em;height:1em;" />
            </a>
          )}
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <section style="margin-top:3rem;">
      <h2 style="margin-bottom:1.25rem;">Photos & video</h2>
      <MediaGallery photos={gallery} video={video} />
    </section>
  </article>
</BaseLayout>
