---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { siteConfig } from "../site.config";

const base = import.meta.env.BASE_URL;
const resumeUrl = `${base}${siteConfig.resumePath}`;
---

<BaseLayout title="Resume" description={`Resume for ${siteConfig.name}.`}>
  <div class="container">
    <header
      class="page-header"
      style="display:flex;flex-wrap:wrap;gap:1.5rem;justify-content:space-between;align-items:flex-end;"
    >
      <div>
        <p class="eyebrow">Resume</p>
        <h1>{siteConfig.name}</h1>
        <p>{siteConfig.title.split(" — ")[1] ?? siteConfig.title}</p>
      </div>
      <a class="btn btn-primary" href={resumeUrl} download>
        Download PDF <Icon name="arrow-right" style="width:1em;height:1em;" />
      </a>
    </header>

    <section class="section--tight">
      <div class="resume-embed">
        <iframe src={resumeUrl} title={`${siteConfig.name} resume PDF`} loading="lazy"></iframe>
      </div>
      <p class="form-hint" style="margin-top:1rem;">
        PDF not loading?{" "}
        <a class="link-inline" href={resumeUrl}>
          Open it directly
        </a>{" "}
        or use the download button above.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .resume-embed {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    background: var(--color-bg-elevated);
  }

  .resume-embed iframe {
    width: 100%;
    height: 85vh;
    min-height: 640px;
    border: 0;
    display: block;
  }
</style>
