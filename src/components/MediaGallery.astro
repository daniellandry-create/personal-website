---
// Renders real photos/video when provided; otherwise reserves visual
// space with placeholders until footage exists.
import Icon from "./Icon.astro";

interface Photo {
  src: string;
  alt: string;
  caption?: string;
  // When set, the photo gets its own full-width row with this text below it.
  description?: string;
}

interface Video {
  src: string;
  poster?: string;
}

interface Props {
  photoCount?: number;
  photos?: Photo[];
  video?: Video;
  // Set false to omit the video section entirely (including its
  // placeholder) for projects with no footage planned yet.
  showVideo?: boolean;
}

const { photoCount = 3, photos, video, showVideo = true } = Astro.props;

// Gallery paths are authored relative to /public (e.g. "/projects/x/shot.jpg"),
// so they need the configured base prepended to work on a project subpath.
// External and data URLs are passed through untouched.
const base = import.meta.env.BASE_URL;
const withBase = (src: string) =>
  /^(?:[a-z][a-z0-9+.-]*:|\/\/)/i.test(src) ? src : `${base}${src.replace(/^\//, "")}`;

// Keep the authored order: runs of plain photos share a grid, and each
// photo with a description breaks out onto its own row.
type Row = { feature: Photo } | { grid: Photo[] };
const rows: Row[] = [];
for (const photo of photos ?? []) {
  const last = rows.at(-1);
  if (photo.description) rows.push({ feature: photo });
  else if (last && "grid" in last) last.grid.push(photo);
  else rows.push({ grid: [photo] });
}
---

<div class="media-gallery">
  {rows.length > 0 ? (
    rows.map((row) =>
      "feature" in row ? (
        <figure class="media-figure media-figure--feature">
          <img
            src={withBase(row.feature.src)}
            alt={row.feature.alt}
            loading="lazy"
            class="media-photo media-photo--feature"
          />
          <figcaption class="media-feature-text">
            {row.feature.caption && <strong>{row.feature.caption}</strong>}
            <p>{row.feature.description}</p>
          </figcaption>
        </figure>
      ) : (
        <div class="media-gallery__grid">
          {row.grid.map((photo) => (
            <figure class="media-figure">
              <img src={withBase(photo.src)} alt={photo.alt} loading="lazy" class="media-photo" />
              {photo.caption && <figcaption class="media-caption">{photo.caption}</figcaption>}
            </figure>
          ))}
        </div>
      ),
    )
  ) : (
    <div class="media-gallery__grid">
      {Array.from({ length: photoCount }).map((_, i) => (
        <div class="media-placeholder">
          <Icon name="image" />
          <span>Photo {i + 1}</span>
        </div>
      ))}
    </div>
  )}
  {video ? (
    <video controls poster={video.poster && withBase(video.poster)} class="media-video">
      <source src={withBase(video.src)} type="video/mp4" />
    </video>
  ) : showVideo ? (
    <div class="media-placeholder media-placeholder--video">
      <Icon name="play" />
      <span>Video walkthrough</span>
    </div>
  ) : null}
</div>

<style>
  .media-figure {
    margin: 0;
  }
  .media-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    object-position: center;
    background: var(--color-bg-inset);
    border-radius: var(--radius-md);
  }
  .media-caption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    text-align: center;
  }
  .media-figure--feature {
    max-width: 42rem;
    margin-top: 1rem;
  }
  .media-photo--feature {
    aspect-ratio: auto;
    height: auto;
  }
  .media-feature-text {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .media-feature-text p {
    margin: 0;
    color: var(--color-text-muted);
  }
  .media-video {
    width: 100%;
    border-radius: var(--radius-md);
  }
</style>
