---
// Horizontal swipeable photo reel. Native scroll-snap drives the swipe
// gesture on touch devices; the prev/next buttons just scroll by one slide
// for mouse/keyboard users, so no carousel JS library is needed.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";

interface Photo {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  photos: Photo[];
  label?: string;
}

const { photos, label = "Photo reel" } = Astro.props;
const reelId = `photo-reel-${Math.random().toString(36).slice(2, 9)}`;

// Render each photo at a shared target height and a width derived from its
// own aspect ratio, so portrait shots stay narrow and landscape shots go
// wide instead of every slide being force-cropped into the same box.
const TARGET_HEIGHT = 640;
const sized = photos.map((photo) => ({
  ...photo,
  width: Math.round(TARGET_HEIGHT * (photo.src.width / photo.src.height)),
  height: TARGET_HEIGHT,
}));
---

<div class="photo-reel" aria-roledescription="carousel" aria-label={label}>
  <ul class="photo-reel__track" id={reelId}>
    {sized.map((photo) => (
      <li class="photo-reel__slide">
        <figure>
          <Image
            src={photo.src}
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            loading="lazy"
          />
          {photo.caption && <figcaption>{photo.caption}</figcaption>}
        </figure>
      </li>
    ))}
  </ul>

  <div class="photo-reel__controls">
    <button type="button" class="photo-reel__btn" data-dir="-1" aria-label="Previous photo" aria-controls={reelId}>
      <Icon name="arrow-right" style="width:1.1em;height:1.1em;transform:rotate(180deg);" />
    </button>
    <button type="button" class="photo-reel__btn" data-dir="1" aria-label="Next photo" aria-controls={reelId}>
      <Icon name="arrow-right" style="width:1.1em;height:1.1em;" />
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll(".photo-reel").forEach(function (reel) {
      const track = reel.querySelector(".photo-reel__track");
      const slide = track && track.querySelector(".photo-reel__slide");
      if (!track || !slide) return;

      reel.querySelectorAll(".photo-reel__btn").forEach(function (btn) {
        btn.addEventListener("click", function () {
          const dir = Number(btn.getAttribute("data-dir")) || 1;
          track.scrollBy({ left: dir * slide.getBoundingClientRect().width, behavior: "smooth" });
        });
      });
    });
  })();
</script>

<style>
  .photo-reel {
    position: relative;
  }

  .photo-reel__track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1px;
    list-style: none;
    padding: 0 0 0.5rem;
    margin: 0;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .photo-reel__slide {
    flex: 0 0 auto;
    max-width: min(78%, 22rem);
    scroll-snap-align: start;
  }

  .photo-reel__slide figure {
    margin: 0;
  }

  .photo-reel__slide img {
    height: 20rem;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    border-radius: var(--radius-md);
    background: var(--color-bg-inset);
    display: block;
    margin: 0 auto;
  }

  .photo-reel__slide figcaption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .photo-reel__controls {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .photo-reel__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-elevated);
    color: var(--color-text);
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .photo-reel__btn:hover {
    border-color: var(--color-accent);
  }

  @media (min-width: 640px) {
    .photo-reel__slide {
      max-width: min(42%, 20rem);
    }

    .photo-reel__slide img {
      height: 24rem;
    }
  }
</style>
